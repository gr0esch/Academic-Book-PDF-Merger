{
  "manifest_version": 3,
  "name": "Academic Book PDF Merger",
  "version": "1.1.0",
  "description": "Download and merge chapter PDFs from academic publisher book pages into a single PDF. Supports Oxford Academic (OUP) and Cambridge University Press (CUP).",
  "permissions": [
    "activeTab",
    "downloads",
    "downloads.open",
    "storage",
    "scripting",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.silverchair.com/*",
    "*://*.oxfordacademic.com/*",
    "*://*.oup.com/*",
    "*://*.cambridge.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
